{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/handoff-inject.sh\"",
            "timeout": 10,
            "statusMessage": "인수인계 읽는 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/handoff-remind.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
